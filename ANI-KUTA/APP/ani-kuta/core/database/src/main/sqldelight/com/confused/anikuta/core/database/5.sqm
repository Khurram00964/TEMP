-- Schema v5 → v6 (ROUND 163, STEP-1: the tracking survival + integrity fix).
--
-- THE DEVICE-CRITICAL DEFECT: track_entry + content_tracking_state still
-- carried FOREIGN KEY (main_id) REFERENCES main_entry(main_id) ON DELETE
-- CASCADE after 3.sqm rebuilt only watch_progress + watch_session (D-862's
-- "tracking survives content removal" doctrine was applied to the WATCH data
-- but NOT to the TRACKER data). Removing an anime from the library silently
-- erased the tracker link (tracker_id/list_id — the ONLY storage of the
-- remote identity) and the user's opt-in flag. The 3.sqm pattern applies:
-- rebuild both tables WITHOUT the FK.
--
-- ALSO: track_entry gains times_watched (the movie-rewatch semantics the
-- Simkl/Trakt models need — the schema was the gap) and the
-- (tracker_type, tracker_id) index becomes UNIQUE (the non-unique one let two
-- main_ids claim the same remote entry, with getTrackEntryByTrackerId's
-- LIMIT 1 silently picking one).
--
-- ORDER MATTERS: dedup BEFORE the UNIQUE index, or the index build fails on
-- a device that somehow carries duplicate remote links. MAX(rowid) per group
-- keeps exactly one row (the most recently inserted) per (tracker_type,
-- tracker_id) — deterministic, always leaves one.

DELETE FROM track_entry WHERE rowid NOT IN (
    SELECT MAX(rowid) FROM track_entry GROUP BY tracker_type, tracker_id
);

CREATE TABLE track_entry_v6 (
    main_id TEXT NOT NULL,
    tracker_type TEXT NOT NULL,
    tracker_id INTEGER NOT NULL,
    status TEXT NOT NULL,
    score INTEGER,
    progress INTEGER NOT NULL DEFAULT 0,
    total_episodes INTEGER,
    list_id INTEGER,
    started_at INTEGER,
    completed_at INTEGER,
    updated_at INTEGER NOT NULL,
    times_watched INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (main_id, tracker_type)
);
INSERT INTO track_entry_v6(
    main_id, tracker_type, tracker_id, status, score, progress,
    total_episodes, list_id, started_at, completed_at, updated_at, times_watched
)
SELECT main_id, tracker_type, tracker_id, status, score, progress,
       total_episodes, list_id, started_at, completed_at, updated_at, 0
FROM track_entry;
DROP TABLE track_entry;
ALTER TABLE track_entry_v6 RENAME TO track_entry;

CREATE UNIQUE INDEX IF NOT EXISTS idx_track_entry_tracker_id
    ON track_entry(tracker_type, tracker_id);

CREATE TABLE content_tracking_state_v6 (
    main_id TEXT NOT NULL,
    tracker_type TEXT NOT NULL,
    tracked INTEGER NOT NULL DEFAULT 0,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY (main_id, tracker_type)
);
INSERT INTO content_tracking_state_v6(main_id, tracker_type, tracked, updated_at)
SELECT main_id, tracker_type, tracked, updated_at FROM content_tracking_state;
DROP TABLE content_tracking_state;
ALTER TABLE content_tracking_state_v6 RENAME TO content_tracking_state;

-- The expired-browse sweep's index (the growth-bound prune reads expires_at;
-- the table stores one row per section key so the sweep is small, but the
-- index keeps it honest as the section-key population grows).
CREATE INDEX IF NOT EXISTS idx_browse_cache_expires ON browse_cache(expires_at);
